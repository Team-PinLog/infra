    {
      "id": 9,
      "title": "영역별 로그 발생량 추이",
      "type": "timeseries",
      "description": "의미: 네 영역의 로그 유입량을 비교하는 중립 추이입니다. 정상: 서비스 특성에 맞는 평소 범위이며 양만으로 건강을 판정하지 않습니다. 확인: 급격한 변화는 상세 로그와 배포 이력을 함께 확인합니다.",
      "datasource": {
        "type": "loki",
        "uid": "$DS_LOKI"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(count_over_time({area=\"frontend\"}[$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "Frontend"
        },
        {
          "expr": "sum(count_over_time({area=\"backend\"}[$__interval]))",
          "refId": "B",
          "queryType": "range",
          "legendFormat": "Backend"
        },
        {
          "expr": "sum(count_over_time({area=\"ai\"}[$__interval]))",
          "refId": "C",
          "queryType": "range",
          "legendFormat": "AI"
        },
        {
          "expr": "sum(count_over_time({area=\"infra\"}[$__interval]))",
          "refId": "D",
          "queryType": "range",
          "legendFormat": "Infra"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
