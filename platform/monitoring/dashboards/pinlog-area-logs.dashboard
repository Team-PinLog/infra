  "panels": [
    {
      "id": 1,
      "title": "Frontend 최근 로그 수",
      "type": "stat",
      "description": "의미: Frontend 영역에서 선택 기간에 수집된 로그 수입니다. 정상: 양과 무관하게 중립 지표이며 0도 장애 판정이 아닙니다. 확인: 변화가 예상과 다르면 상세 대시보드와 Explore에서 selector를 확인합니다.",
      "datasource": {
        "type": "loki",
        "uid": "$DS_LOKI"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({area=\"frontend\"}[$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
